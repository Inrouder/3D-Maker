{
  "name": "3d-maker",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dist:portable": "npm run icon:generate && npm run build && electron-builder --win portable",
    "icon:generate": "node build/generate-icon.cjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "three-bvh-csg": "^0.0.17",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.4",
    "png-to-ico": "^2.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "de.inrouder.threedmaker",
    "productName": "3D-Maker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "3D-Maker-Portable-${version}.${ext}"
    }
  }
}
